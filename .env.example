# GraphNexus 环境变量
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# 运行前加载环境变量：
#   source .env && mvn spring-boot:run -Dspring-boot.run.profiles=dev

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=sk-your-key-here

# Ollama 本地部署（兜底，无需额外配置）
# ollama pull deepseek-r1:7b && ollama serve
OLLAMA_HOST=http://localhost:11434