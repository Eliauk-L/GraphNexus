# =============================================================================
# GraphNexus 环境变量模板
# =============================================================================
# 使用方式:
#   cp .env.example .env
#   编辑 .env 填入真实值
#   source .env && podman compose -f deployment/podman-compose.app.yml up -d
# =============================================================================

# ---- 基础设施凭证（与 podman-compose.yml 保持一致即可） ----
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=graphnexus123

MYSQL_USERNAME=graphnexus
MYSQL_PASSWORD=graphnexus123

REDIS_PASSWORD=graphnexus123

RABBITMQ_USERNAME=graphnexus
RABBITMQ_PASSWORD=graphnexus123
RABBITMQ_VHOST=graphnexus

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=graphnexus-prod

# ---- 外部 API 密钥（必填，否则 AI 功能不可用） ----
LLM_API_KEY=sk-your-key-here
MINERU_API_TOKEN=your-mineru-token-here