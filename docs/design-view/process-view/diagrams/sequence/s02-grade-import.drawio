        <!-- Upload flow -->
        <mxCell id="p1-note" value="成绩 CSV/Excel 上传" style="text;fontSize=10;fontStyle=1;fontColor=#E67E22;fillColor=#FEF9E7;strokeColor=#E67E22;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="110" width="140" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="m1" value="选择学科+CSV" style="endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#333;fontSize=8;" edge="1" parent="1">
