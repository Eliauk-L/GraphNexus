      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="S2 · 成绩CSV导入 (UC-02, Story 1.2) — 同步上传→MySQL" style="rounded=1;whiteSpace=wrap;fillColor=#2C3E50;strokeColor=#1a252f;fontSize=14;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
